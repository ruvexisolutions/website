# ============================================================
#  RUVEXI Solutions Website (Next.js) — Environment Variables
#  Copy this file to .env.local (dev) or set in Railway/Netlify
# ============================================================

# ── Supabase (Public URL & Anon Key only) ─────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://mmnkllguzhakarikyniq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Backend API & Domain ──────────────────────────────────────
NEXT_PUBLIC_API_URL=https://web-production-7d450.up.railway.app/api/v1
BACKEND_INTERNAL_URL=https://web-production-7d450.up.railway.app
NEXT_PUBLIC_ROOT_DOMAIN=ruvexi.netlify.app

# ── Google OAuth & Meta Embedded Signup (Public Client IDs) ───
# Optional on frontend: if omitted, fetched dynamically from Railway /api/v1/auth/public-config
NEXT_PUBLIC_GOOGLE_CLIENT_ID=688082902607-cuotmpb605mn5i7jkjv6ojql16bkmdml.apps.googleusercontent.com
NEXT_PUBLIC_META_APP_ID=YOUR_META_APP_ID

# ── Server-Side Only AI Fallback (optional if handled via Railway /api/v1/ai/generate) ──
# Never prefix private keys with NEXT_PUBLIC_
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

